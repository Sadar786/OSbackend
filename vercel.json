{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/ping", "destination": "/api/index.js" }
  ],
  "functions": {
    "api/index.js": { "runtime": "nodejs20.x", "memory": 1024, "maxDuration": 10 }
  }
}
